{% doc %}
  @prompt
    An interactive vertical timeline that highlights as the user scrolls
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-timeline-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-timeline-wrapper-{{ ai_gen_id }} {
    position: relative;
    padding-left: {{ block.settings.timeline_offset }}px;
  }

  .ai-timeline-line-{{ ai_gen_id }} {
    position: absolute;
    left: {{ block.settings.dot_size | divided_by: 2 }}px;
    top: 0;
    width: {{ block.settings.line_width }}px;
    height: 100%;
    background-color: {{ block.settings.line_color }};
    transition: background-color 0.3s ease;
  }

  .ai-timeline-line-progress-{{ ai_gen_id }} {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 0%;
    background-color: {{ block.settings.line_active_color }};
    transition: height 0.3s ease;
  }

  .ai-timeline-item-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: flex-start;
    margin-bottom: {{ block.settings.item_spacing }}px;
    opacity: {{ block.settings.inactive_opacity | divided_by: 100.0 }};
    transition: opacity 0.3s ease;
  }

  .ai-timeline-item-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-timeline-dot-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: {{ block.settings.dot_border_width }}px solid {{ block.settings.line_color }};
    flex-shrink: 0;
    z-index: 2;
    transition: all 0.3s ease;
  }

  .ai-timeline-item-{{ ai_gen_id }}.active .ai-timeline-dot-{{ ai_gen_id }} {
    background-color: {{ block.settings.dot_active_color }};
    border-color: {{ block.settings.line_active_color }};
    transform: scale({{ block.settings.dot_scale | divided_by: 100.0 }});
  }

  .ai-timeline-content-{{ ai_gen_id }} {
    margin-left: {{ block.settings.content_offset }}px;
    padding-bottom: 20px;
  }

  .ai-timeline-date-{{ ai_gen_id }} {
    font-size: {{ block.settings.date_size }}px;
    color: {{ block.settings.date_color }};
    margin-bottom: 8px;
    display: block;
  }

  .ai-timeline-item-{{ ai_gen_id }}.active .ai-timeline-date-{{ ai_gen_id }} {
    color: {{ block.settings.date_active_color }};
  }

  .ai-timeline-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 8px;
    font-weight: 600;
  }

  .ai-timeline-item-{{ ai_gen_id }}.active .ai-timeline-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_active_color }};
  }

  .ai-timeline-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-timeline-item-{{ ai_gen_id }}.active .ai-timeline-description-{{ ai_gen_id }} {
    color: {{ block.settings.description_active_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-timeline-wrapper-{{ ai_gen_id }} {
      padding-left: {{ block.settings.timeline_offset | times: 0.6 }}px;
    }

    .ai-timeline-content-{{ ai_gen_id }} {
      margin-left: {{ block.settings.content_offset | times: 0.6 }}px;
    }

    .ai-timeline-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-timeline-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<vertical-timeline-{{ ai_gen_id }} class="ai-timeline-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-timeline-wrapper-{{ ai_gen_id }}">
    <div class="ai-timeline-line-{{ ai_gen_id }}">
      <div class="ai-timeline-line-progress-{{ ai_gen_id }}"></div>
    </div>

    {% for i in (1..block.settings.timeline_items) %}
      {% liquid
        assign date_key = 'item_' | append: i | append: '_date'
        assign title_key = 'item_' | append: i | append: '_title'
        assign description_key = 'item_' | append: i | append: '_description'
        
        assign item_date = block.settings[date_key]
        assign item_title = block.settings[title_key]
        assign item_description = block.settings[description_key]
      %}

      {% if item_title != blank or item_description != blank %}
        <div class="ai-timeline-item-{{ ai_gen_id }}" data-timeline-item>
          <div class="ai-timeline-dot-{{ ai_gen_id }}"></div>
          <div class="ai-timeline-content-{{ ai_gen_id }}">
            {% if item_date != blank %}
              <span class="ai-timeline-date-{{ ai_gen_id }}">{{ item_date }}</span>
            {% endif %}
            {% if item_title != blank %}
              <h3 class="ai-timeline-title-{{ ai_gen_id }}">{{ item_title }}</h3>
            {% endif %}
            {% if item_description != blank %}
              <div class="ai-timeline-description-{{ ai_gen_id }}">{{ item_description }}</div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</vertical-timeline-{{ ai_gen_id }}>

<script>
  (function() {
    class VerticalTimeline{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.items = [];
        this.progressLine = null;
        this.isScrolling = false;
      }

      connectedCallback() {
        this.items = Array.from(this.querySelectorAll('[data-timeline-item]'));
        this.progressLine = this.querySelector('.ai-timeline-line-progress-{{ ai_gen_id }}');
        
        if (this.items.length === 0) return;

        this.setupScrollListener();
        this.updateTimeline();
      }

      setupScrollListener() {
        let ticking = false;

        window.addEventListener('scroll', () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              this.updateTimeline();
              ticking = false;
            });
            ticking = true;
          }
        });
      }

      updateTimeline() {
        const scrollPosition = window.scrollY + window.innerHeight / 2;
        let activeIndex = -1;
        let maxProgress = 0;

        this.items.forEach((item, index) => {
          const itemTop = item.getBoundingClientRect().top + window.scrollY;
          const itemHeight = item.offsetHeight;
          const itemCenter = itemTop + itemHeight / 2;

          if (scrollPosition >= itemCenter) {
            activeIndex = index;
            item.classList.add('active');
          } else {
            item.classList.remove('active');
          }

          if (activeIndex >= 0 && index === activeIndex) {
            const firstItemTop = this.items[0].getBoundingClientRect().top + window.scrollY;
            const lastItemBottom = itemTop + itemHeight;
            const totalHeight = lastItemBottom - firstItemTop;
            const scrolledHeight = itemTop - firstItemTop + itemHeight / 2;
            maxProgress = Math.min(100, (scrolledHeight / totalHeight) * 100);
          }
        });

        if (activeIndex === -1) {
          maxProgress = 0;
        } else if (activeIndex === this.items.length - 1) {
          const lastItem = this.items[this.items.length - 1];
          const lastItemTop = lastItem.getBoundingClientRect().top + window.scrollY;
          const lastItemBottom = lastItemTop + lastItem.offsetHeight;
          
          if (scrollPosition >= lastItemBottom) {
            maxProgress = 100;
          }
        }

        if (this.progressLine) {
          this.progressLine.style.height = maxProgress + '%';
        }
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this.updateTimeline);
      }
    }

    customElements.define('vertical-timeline-{{ ai_gen_id }}', VerticalTimeline{{ ai_gen_id }});
  })();
</script>

